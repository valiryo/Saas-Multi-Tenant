{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".", 
    "paths": {
      "@shared/*": ["src/modules/shared/*"], 
      "@users/*": ["src/modules/usuarios/*"] 
    }
  },
  "include": ["src/**/*", "test/**/*"], 
  "exclude": ["node_modules", "dist"]
}