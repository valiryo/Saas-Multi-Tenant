{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/typescript-config/base.json",
  "compilerOptions": {
    "composite": true, //posso ser referenciado por outros projetos (por Project References)? precisa de compilação incremental, pois ela guarda o estado da compilação dos outros projetos e depois fica fácil resolver o grafo de dependências
    "rootDir": "src", //onde estao os codigos fontes que serão compilados
    "outDir": "dist", //onde os codigos compilados serão colocados
    "baseUrl": ".", 
    "paths": { //aliases do typescript. não traduz automaticamente os alias em caminhos nos códigos javascript compilados, mas o tsconfig-paths faz isso.
      "@shared/*": ["src/modules/shared/*"], 
      "@users/*": ["src/modules/usuarios/*"],
      "@organizacoes/*": ["src/modules/organizacoes/*"]
    }
  },
  "include": ["src/**/*.ts"],  //escolhe quais arquivos dentr do rootDir serão compilados
  "exclude": ["node_modules", "dist"]
}