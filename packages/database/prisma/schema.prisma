generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoCargo {
  ADMINISTRADOR
  FUNCIONARIO
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  vinculosEmpregaticios VinculoEmpregaticio[]
}

model Organizacao {
  id       String   @id @default(uuid())
  nome     String
  slug     String   @unique
  criadoEm DateTime @default(now())

  vinculosEmpregaticios VinculoEmpregaticio[]
}

model VinculoEmpregaticio {
  id            String    @id @default(uuid())
  usuarioId     String
  organizacaoId String
  cargo         TipoCargo
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  organizacao                   Organizacao                    @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  
  historicoVinculoEmpregaticios HistoricoVinculoEmpregaticio[]

  @@unique([usuarioId, organizacaoId])
  @@index([organizacaoId])
}

model HistoricoVinculoEmpregaticio {
  id         String    @id @default(uuid())
  vinculoId  String
  cargo      TipoCargo
  ativo      Boolean
  alteradoEm DateTime  @default(now())

  vinculo VinculoEmpregaticio @relation(fields: [vinculoId], references: [id], onDelete: Restrict)

  @@index([vinculoId])
  @@index([vinculoId, alteradoEm])
}
