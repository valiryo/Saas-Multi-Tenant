generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())

  vinculos VinculoOrganizacao[]
}

model Organizacao {
  id       String   @id @default(uuid())
  nome     String
  slug     String   @unique
  criadoEm DateTime @default(now())

  vinculos VinculoOrganizacao[]
}

model VinculoOrganizacao {
  id            String @id @default(uuid())
  usuarioId     String
  organizacaoId String
  papel         String

  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])

  @@unique([usuarioId, organizacaoId])
}